# Copiez ce fichier en .env pour le développement local.
# En production, définissez ces valeurs via le gestionnaire de secrets.
DJANGO_DEBUG=True
# Laisser vide en développement déclenche une clé temporaire ; définir une vraie clé en production.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# À True seulement derrière un proxy de confiance qui assainit X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False

# sqlite (développement) ou postgresql (production recommandée)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_TIMEOUT=20
# Pour PostgreSQL : configurez DB_ENGINE=postgresql puis renseignez ces valeurs.
DB_USER=sunureservation
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# E-mail : la console Django est utilisée par défaut en local.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SunuRéservation <noreply@example.com>
